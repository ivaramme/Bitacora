# Auto detect text files and perform LF normalization
* text=auto

# Java source files
*.java text diff=java
*.xml text
*.properties text
*.yml text
*.yaml text

# Scripts
*.sh text eol=lf
*.bat text eol=crlf

# Documentation
*.md text
*.txt text

# Binary files
*.jar binary
*.class binary
*.so binary
*.dll binary
*.dylib binary

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text

# Archives
*.zip binary
*.tar binary
*.gz binary
*.7z binary